//choice parameters with code
pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['Apply', 'Destroy'],
            description: 'Select the Terraform action'
        )
    }

    stages {

        stage('Git Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Goutham-id06/terraform.git'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('day-1') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression {
                    params.ACTION == 'Apply'
                }
            }
            steps {
                dir('day-1') {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Approval') {
            steps {
                input(
                    message: "You selected ${params.ACTION}. Continue?",
                    ok: "Proceed"
                )
            }
        }

        stage('Execute') {
            steps {
                script {
                    if (params.ACTION == 'Apply') {
                        dir('day-1') {
                            sh 'terraform apply -auto-approve tfplan'
                        }
                    } else {
                        dir('day-1') {
                            sh 'terraform destroy -auto-approve'
                        }
                    }
                }
            }
        }
    }
}

